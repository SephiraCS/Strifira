# TS-795: retained current-runtime input inventory, not a zero-config production recipe.
# Production features and all regions are always on with fixed settings.
# NetBird membership admits nodes; local region and service endpoints are inferred.
# OCI Vault must create/deliver first-party secrets and retrieve vendor keys stored once.
# These examples/readers do not yet implement that automation. Values and keys remain
# unchanged here; later COS work removes production switches and tuning inputs.
# Fakes, demo stores and skip-auth belong only in test code and test binaries.
# Never deploy example credentials, demo identities or unresolved placeholders.
DATABASE_URL=postgres://strifira:strifira@localhost:5432/strifira?sslmode=disable
JWT_SECRET=local_dev_jwt_secret_32_chars_minimum_do_not_use_prod
PORT=8080
# Vite dev server overrides (root .env or process environment; defaults shown).
# STRIFIRA_DEV_API_URL=http://localhost:8080
# STRIFIRA_DEV_UI_PORT=5173
# Optional listener interface; set for isolated local test instances.
# BIND_ADDRESS=127.0.0.1
# Exact frontend origin (scheme + host + optional port). Dev Machine native
# terminal WebSockets require their Origin to match this value exactly.
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
# Seeded Alice. Demo mode uses SYSADMINS as the allowlist for Dev Machines.
SYSADMINS=a0000000-0000-0000-0000-000000000001

# Existing demo-path inventory; move to test code/binaries in later COS work.
# This path is not permitted in a production deployment.
# When this is true only users listed in SYSADMINS may create or use
# Dev Machines; all other authenticated users receive 403 on every
# Dev Machine API route, and the machine gateway rejects non-sysadmin
# ticket exchanges and sessions.
PUBLIC_DEMO_MODE=true
# With no override, the UI exposes all five users created by `make seed`.
# PUBLIC_DEMO_USERS='[{"label":"Owner","email":"alice@strifira.dev","password":"Password123!"}]'

# Files live in the embedded NATS JetStream object store (bucket
# strifira-files), persisted under uploads/.jetstream on the uploads volume;
# every node in a cluster serves any file from the replicated store. There is
# no storage backend selection.

# Cluster seeds (NATS_SEED_URLS): cluster addresses of the other nodes. The
# embedded NATS server joins the cluster through any one of them; empty
# means a single-node cluster (development and single-instance deployments).
# NATS_SEED_URLS=nats://strifira-2:6222,nats://strifira-3:6222

# Current GitHub shared-instance inputs; automatic Vault pickup remains migration debt.
# Existing runtime uses a shared connection when these inputs are present;
# workspace-owned repository authorization remains required.
# GITHUB_URL=https://github.com
# GITHUB_TOKEN=

# Disposable development webhook target override; not a production tuning recipe.
# GITHUB_WEBHOOK_URL=

# Dev Machines local development. `make dev-start-services` builds the runtime
# images, provisions the restricted local gateway role, and starts the manager,
# gateway, and Caddy wildcard TLS proxy for https://*.machines.localhost.
# The dev proxy binds 127.0.0.1:80 and 127.0.0.1:443, so stop the selfhosting
# stack first if it is already using those ports. The browser must trust
# Caddy's local CA for warning-free wildcard TLS launches.
# The machine domain must be a separate registrable domain, not a sibling
# subdomain of the main app. machines.localhost is the local-development
# exception. Production requires wildcard TLS via DNS-01 Caddy or a mounted cert.
# FRONTEND_URL must be the exact public frontend origin for native terminal WS.
# Workspace policy controls maximum hard runtime and idle pause; default idle
# pause is 240 minutes, keep_running=true bypasses idle pause, and no automatic
# deletion is performed.
# Workspace disk limits require Docker's data root on XFS mounted with pquota or
# prjquota. The manager fails startup when local-volume hard quotas are unavailable.
DEV_MACHINES_ENABLED=true
DEV_MACHINE_DOMAIN=machines.localhost
DEV_MACHINE_ENCRYPTION_KEY=local_dev_machine_encryption_key_32_chars_minimum
# Local placeholder required by manager validation. Collector delivery needs an
# HTTPS URL reachable from machine containers; use an HTTPS tunnel/public dev URL
# if you need collector telemetry while running the backend directly on the host.
DEV_MACHINE_INGEST_URL=https://strifira.localhost/api/dev-machine-ingest
DEV_MACHINE_SESSION_TTL_MINUTES=480
DEV_MACHINE_ACCESS_TICKET_TTL_SECONDS=60
DEV_MACHINE_GATEWAY_CONTAINER=strifira-dev-machine-gateway
# Clearly local restricted gateway role defaults. Do not reuse in production.
DEV_MACHINE_GATEWAY_DB_USER=strifira_gateway_dev
DEV_MACHINE_GATEWAY_DB_PASSWORD=local_dev_gateway_password_do_not_use_prod
# DEV_MACHINE_GATEWAY_DATABASE_URL=postgres://strifira_gateway_dev:local_dev_gateway_password_do_not_use_prod@postgres:5432/strifira?sslmode=disable
DEV_MACHINE_PULL_IMAGES=false
# `make dev-start-services` computes daemon socket ownership for Colima/Linux.
# The remaining direct-Compose override is current input inventory.
DEV_MACHINE_DOCKER_GID=0
DEV_MACHINE_DOCKER_HOST=unix:///var/run/docker.sock
DEV_MACHINE_SECCOMP_PROFILE=
DEV_MACHINE_APPARMOR_PROFILE=
DEV_MACHINE_EGRESS_ALLOWLIST=
DEV_MACHINE_EGRESS_DENYLIST=
# Local runtime image tags built by `make dev-start-services`. The developer
# image includes code-server, ttyd, tmux, and pinned OpenCode/Claude Code/Codex
# CLIs; provider agent images are pinned separately.
DEV_MACHINE_IDE_IMAGE=strifira/dev-machine-ide:dev
DEV_MACHINE_BROWSER_IMAGE=strifira/dev-machine-browser:dev
DEV_MACHINE_COLLECTOR_IMAGE=strifira/dev-machine-collector:dev
DEV_MACHINE_EGRESS_IMAGE=strifira/dev-machine-egress:dev
DEV_MACHINE_CLAUDE_IMAGE=strifira/dev-machine-agent-claude:dev
DEV_MACHINE_OPENCODE_IMAGE=strifira/dev-machine-agent-opencode:dev
DEV_MACHINE_CODEX_IMAGE=strifira/dev-machine-agent-codex:dev
