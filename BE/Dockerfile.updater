FROM golang:1.27.1-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 go build -o /out/ku-updater ./cmd/updater

FROM alpine:3.21
RUN apk add --no-cache bash ca-certificates docker-cli docker-cli-compose git openssh-client
WORKDIR /repo
COPY --from=builder /out/ku-updater /usr/local/bin/ku-updater
EXPOSE 8081
CMD ["ku-updater"]
