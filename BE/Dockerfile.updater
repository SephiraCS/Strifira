FROM docker.io/library/golang:1.27.2-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/strifira-updater ./cmd/updater

FROM docker.io/library/alpine:3.24
RUN apk add --no-cache bash ca-certificates docker-cli docker-cli-compose git openssh-client
WORKDIR /repo
COPY --from=builder /out/strifira-updater /usr/local/bin/strifira-updater
EXPOSE 8081
CMD ["strifira-updater"]
