FROM docker.io/library/golang:1.27.2-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /machine-manager ./cmd/machine-manager

FROM docker.io/library/alpine:3.24
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -g 1000 ku \
    && adduser -D -u 1000 -G ku ku
COPY --from=builder /machine-manager /usr/local/bin/machine-manager
EXPOSE 8092
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/machine-manager"]
