{
	"name": "ui",
	"private": true,
	"version": "0.3.31",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage cookie baseLocale --output-structure locale-modules --emit-ts-declarations && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:locales": "node scripts/check-locales.mjs",
		"test:unit": "node --test tests/unit/*.test.mjs",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.49.0",
		"@playwright/test": "^1.63.0",
		"@scalar/api-reference": "1.72.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"paneforge": "^1.0.2",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-dnd-action": "^0.9.79",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.1"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.25.4",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-bubble-menu": "^3.31.3",
		"@tiptap/extension-code-block-lowlight": "^3.31.3",
		"@tiptap/extension-collaboration": "^3.31.3",
		"@tiptap/extension-image": "^3.31.3",
		"@tiptap/extension-link": "^3.31.3",
		"@tiptap/extension-placeholder": "^3.31.3",
		"@tiptap/extension-table": "^3.31.3",
		"@tiptap/extension-task-item": "^3.31.3",
		"@tiptap/extension-task-list": "^3.31.3",
		"@tiptap/extension-underline": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"@types/turndown": "^5.0.6",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"dompurify": "^3.4.16",
		"echarts": "^6.1.0",
		"emoji-picker-element": "^1.29.1",
		"highlight.js": "~11.11.1",
		"lowlight": "^3.3.0",
		"markdown-it": "^15.0.2",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.42.6",
		"svelte-tiptap": "^3.0.1",
