#!/bin/sh
set -eu

attempt=0
while [ ! -f /run/ku-secrets/.ready ]; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 300 ]; then
    echo "timed out waiting for scoped agent secrets" >&2
    exit 1
  fi
  sleep 0.1
done

old_ifs=$IFS
IFS=,
for secret_name in ${KU_SECRET_NAMES:-}; do
  case "$secret_name" in
    ''|*[!A-Za-z0-9_]*) echo "invalid secret name" >&2; exit 1 ;;
  esac
  secret_file="/run/ku-secrets/$secret_name"
  if [ -f "$secret_file" ]; then
    secret_value=$(cat "$secret_file"; printf x)
    secret_value=${secret_value%x}
    export "$secret_name=$secret_value"
    rm -f "$secret_file"
  fi
done
IFS=$old_ifs
rm -f /run/ku-secrets/.ready

home_dir=${HOME:-/home/ku}
credential_helper=${KU_GIT_CREDENTIAL_HELPER:-$home_dir/.ku-git-credential}
case "$credential_helper" in /* ) ;; * ) echo "invalid credential helper path" >&2; exit 1 ;; esac
helper_dir=${credential_helper%/*}
mkdir -p "$helper_dir"
old_umask=$(umask)
umask 077
cat > "$credential_helper" <<'SCRIPT'
#!/bin/sh
case "${1:-get}" in
  get ) ;;
  store|erase ) exit 0 ;;
  * ) exit 0 ;;
esac
protocol=
host=
path=
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
    path=*) path=${line#path=} ;;
  esac
done
[ "$protocol" = https ] || exit 0
path=${path%.git}
if [ -n "${FORGEJO_TOKEN:-}" ] && [ -n "${KU_FORGEJO_HOST:-}" ] && [ -n "${KU_GIT_REPOSITORY:-}" ] \
    && [ "$host" = "$KU_FORGEJO_HOST" ] && [ "$path" = "$KU_GIT_REPOSITORY" ]; then
  printf '%s\n' username=oauth2
  printf '%s\n' "password=$FORGEJO_TOKEN"
elif [ "$host" = github.com ] && [ -n "${GITHUB_TOKEN:-}" ] \
    && { [ -z "${KU_GIT_REPOSITORY:-}" ] || [ "$path" = "$KU_GIT_REPOSITORY" ]; }; then
  printf '%s\n' username=x-access-token
  printf '%s\n' "password=$GITHUB_TOKEN"
fi
SCRIPT
chmod 0700 "$credential_helper"
umask "$old_umask"
git config --global --unset-all core.askPass >/dev/null 2>&1 || true
git config --global --unset-all credential.helper >/dev/null 2>&1 || true
git config --global credential.helper "$credential_helper"
git config --global credential.useHttpPath true
export GIT_TERMINAL_PROMPT=0

exec "$@"
